# --- Project outputs ---
# Worlds are regenerable from a seed; never commit them, and never let a
# holdout world reach the repo where it could be inspected.
worlds/
results/

# Generated databases live under data/ so the repo root stays clean and a
# stray artifact cannot be committed by a careless `git add -A`.
# Ignore the directory's CONTENTS rather than the directory itself: git does not
# descend into an ignored directory, so a `!data/file` exception under `data/`
# silently never applies.
data/*
# ...except the recorded holdout run. That one is evidence rather than a
# generated intermediate: it cost real API calls, an LLM cannot reproduce it
# deterministically, and the README's headline result rests on it. Without it
# the dashboard cannot be built from a clean clone at all.
!data/holdout_results.json
*.db
*.sqlite
*.sqlite3

