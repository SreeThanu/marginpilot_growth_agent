# Copy to .env and fill in. .env is gitignored and must never be committed.

# Razorpay — TEST MODE ONLY. Live keys must never appear in this project.
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signature secret configured in the Razorpay test dashboard.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM clients — consumed only by src/agent/. Set whichever provider you have;
# the reasoner is swappable and each raises rather than silently falling back.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter — used only by the api/evaluate REST proposer, and only when it is
# named explicitly with MARGINPILOT_PROPOSER=openrouter. It is not in the
# `auto` chain and is not a default; without that variable this key is unused.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Model override for that transport. Empty or absent keeps
# api/evaluate.DEFAULT_OPENROUTER_MODEL (nvidia/nemotron-3-super-120b-a12b).
MARGINPILOT_OPENROUTER_MODEL=
