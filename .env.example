# Copy to .env and fill in. .env is gitignored and must never be committed.

# Razorpay — TEST MODE ONLY. Live keys must never appear in this project.
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signature secret configured in the Razorpay test dashboard.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM client — consumed only by src/agent/.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
